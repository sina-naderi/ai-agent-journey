        "jsCode": "// Get all posts\nconst items = $input.all();\n\n// Format posts as a news digest\nconst newsText = items.map((item, index) => {\n    const post = item.json;\n    return `${index + 1}. ${post.title}\\n${post.body.substring(0, 100)}...`;\n}).join('\\n\\n');\n\nreturn [{\n    json: {\n        news_text: newsText,\n        count: items.length,\n        date: new Date().toISOString().split('T')[0]\n    }\n}];"
      },
