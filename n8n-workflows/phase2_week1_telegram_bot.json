    {
      "parameters": {
        "jsCode": "// Extract message data from Telegram webhook\nconst body = $input.first().json.body;\nconst message = body.message;\n\nconst chatId = message.chat.id;\nconst text = message.text || \"\";\nconst firstName = message.from.first_name || \"Friend\";\n\n// Simple response logic\nlet response;\nif (text.toLowerCase().includes(\"hello\") || text.toLowerCase().includes(\"hi\")) {\n    response = `Hello ${firstName}! 👋 I'm your AI assistant bot.`;\n} else if (text.toLowerCase().includes(\"time\")) {\n    response = `Current time: ${new Date().toLocaleString()}`;\n} else if (text.toLowerCase().includes(\"help\")) {\n    response = `Available commands:\\n- hello: greeting\\n- time: current time\\n- help: show this menu`;\n} else {\n    response = `You said: \"${text}\"\\nI'm still learning! Try: hello, time, or help`;\n}\n\nreturn [{\n    json: {\n        chat_id: chatId,\n        text: response\n    }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
